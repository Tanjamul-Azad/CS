# Base for registry network servers: Node 24 (NODE_USE_ENV_PROXY) and Python 3.12 + uv.
FROM node:24-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates \
 && rm -rf /var/lib/apt/lists/* && python3 -m venv /opt/py && /opt/py/bin/pip install --no-cache-dir uv
ENV PATH=/opt/py/bin:$PATH
